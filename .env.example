# Discord bot token from https://discord.com/developers/applications
CORDLE_TOKEN=

# Optional. Shift the daily rollover away from UTC midnight.
# e.g. -6 for US Central, 1 for CET.
CORDLE_UTC_OFFSET_HOURS=0

# Optional. Sync slash commands to one guild for instant availability while
# developing. Leave blank to sync globally (can take up to an hour).
CORDLE_DEV_GUILD_ID=

# Optional. DEBUG, INFO, WARNING, ERROR.
CORDLE_LOG_LEVEL=INFO
